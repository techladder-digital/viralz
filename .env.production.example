# Production environment for viralz.online
# Copy this to .env.production on the SERVER (not in git) and fill in real values.

# === Required
MAIN_URL="https://viralz.online"
FRONTEND_URL="https://viralz.online"
NEXT_PUBLIC_BACKEND_URL="https://viralz.online/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
DATABASE_URL="postgresql://viralz-user:REPLACE_WITH_POSTGRES_PASSWORD@viralz-postgres:5432/viralz-db"
REDIS_URL="redis://viralz-redis:6379"
TEMPORAL_ADDRESS="temporal:7233"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"

# === Storage
# Starting on local disk storage so launch isn't blocked on Cloudflare R2 keys.
# Switch to "cloudflare" once CLOUDFLARE_* values below are filled in (needed for
# saving social media avatars per Postiz's own docs).
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"

# STORAGE_PROVIDER="cloudflare"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME=""
CLOUDFLARE_BUCKET_URL=""
CLOUDFLARE_REGION="auto"

# === Email: Resend (account activation / password reset)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@viralz.online"
EMAIL_FROM_NAME="Viralz"

# === Billing: Stripe
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# === Social Media API Settings (fill in as you register each platform's app,
# using https://viralz.online/... as the OAuth callback domain)
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_BUSINESS_CLIENT_ID=""
TIKTOK_BUSINESS_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# === Misc
API_LIMIT=30
NX_ADD_PLUGINS=false
